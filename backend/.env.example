# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_grade
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Security - CHANGE THIS IN PRODUCTION
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI APIs (optional - falls back to mock if not set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Tavily web search (optional - enables real-time web search in chat)
# Get your key at https://app.tavily.com
TAVILY_API_KEY=
GOOGLE_API_KEY=

# Billing (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# App
APP_VERSION=1.0.0
APP_NAME=Enterprise Grade AI Copilot API
SEED_DEMO_USERS=false
